# Adapted from https://github.com/devkitPro/pacman-packages (freetushkan)

pkgname=ps4-openorbis-libplacebo
pkgver=6.338.2
vulkanver=1.3.283
pkgrel=1
pkgdesc="Reusable library for GPU-accelerated video/image rendering primitives"
arch=('any')
license=('LGPL2.1')
options=(!strip libtool staticlibs)
source=(
  "https://code.videolan.org/videolan/libplacebo/-/archive/v${pkgver}/libplacebo-v${pkgver}.tar.gz"
  "vulkan-headers-${vulkanver}.tar.gz::https://github.com/KhronosGroup/Vulkan-Headers/archive/v${vulkanver}.tar.gz"
)
sha256sums=('d029adbe55bba8aed7aed2c48b0b66081dddfb9d42683a709342e33aa666c544'
            'a76ff77815012c76abc9811215c2167128a73a697bcc23948e858d1f7dd54a85')
makedepends=('ps4-openorbis-pkg-config' 'ps4-openorbis-vars')
groups=(
  'pacbrew' 'pacbrew-ps4' 'pacbrew-ps4-portlibs'
  'ps4-openorbis-portlibs' # for backward compatibility
)

build() {
  cd libplacebo-v${pkgver}

  source /opt/pacbrew/ps4/openorbis/ps4vars.sh
  {
    echo "[binaries]"
    echo "c = '${CC}'"
    echo "cpp = '${CXX}'"
    echo "ar = '${AR}'"
    echo "strip = '${STRIP}'"
    echo "[host_machine]"
    echo "system = 'freebsd'"
    echo "cpu_family = 'x86_64'"
    echo "cpu = 'x86_64'"
    echo "endian = 'little'"
  } > ps4_cross.txt

  cp -r ../Vulkan-Headers-${vulkanver}/include/* src/include
  {
    echo "#include <cstdlib>"
    echo "#include <cstdio>"
    echo "#include <alloca.h>"
    echo ""
    echo "// Переопределяем структуры из C++17 <charconv>, чтобы не зависеть от хост-системы"
    echo "enum class chars_format { general = 1, scientific = 2, fixed = 4, hex = 8 };"
    echo "enum class errc { invalid_argument = 22, value_too_large = 34 };"
    echo ""
    echo "struct from_chars_result { const char* ptr; errc ec; };"
    echo "struct to_chars_result { char* ptr; errc ec; };"
    echo ""
    echo "namespace std {"
    echo "  from_chars_result from_chars(const char* f, const char* l, float& v, chars_format fmt = chars_format::general) noexcept {"
    echo "    size_t len = l - f;"
    echo "    char* buf = (char*)alloca(len + 1);"
    echo "    for(size_t i = 0; i < len; ++i) buf[i] = f[i];"
    echo "    buf[len] = '\\0';"
    echo "    char* e;"
    echo "    v = ::strtof(buf, &e);"
    echo "    if (e == buf) return {f, errc::invalid_argument};"
    echo "    return {f + (e - buf), errc{}};"
    echo "  }"
    echo "  from_chars_result from_chars(const char* f, const char* l, double& v, chars_format fmt = chars_format::general) noexcept {"
    echo "    size_t len = l - f;"
    echo "    char* buf = (char*)alloca(len + 1);"
    echo "    for(size_t i = 0; i < len; ++i) buf[i] = f[i];"
    echo "    buf[len] = '\\0';"
    echo "    char* e;"
    echo "    v = ::strtod(buf, &e);"
    echo "    if (e == buf) return {f, errc::invalid_argument};"
    echo "    return {f + (e - buf), errc{}};"
    echo "  }"
    echo "  to_chars_result to_chars(char* first, char* last, float value) noexcept {"
    echo "    int len = ::snprintf(first, last - first, \"%%g\", value);"
    echo "    if (len < 0 || len >= (last - first)) return {last, errc::value_too_large};"
    echo "    return {first + len, errc{}};"
    echo "  }"
    echo "  to_chars_result to_chars(char* first, char* last, double value) noexcept {"
    echo "    int len = ::snprintf(first, last - first, \"%%g\", value);"
    echo "    if (len < 0 || len >= (last - first)) return {last, errc::value_too_large};"
    echo "    return {first + len, errc{}};"
    echo "  }"
    echo "}"
    echo ""
    echo "extern \"C\" {"
    echo "  /* Закрываем ассерт для всех возможных типов line (и для старых SDK, и для новых) */"
    echo "  void __glibcxx_assert_fail(const char*, int, const char*, const char*) { ::abort(); }"
    echo "  void __assert_fail(const char*, const char*, unsigned int, const char*) { ::abort(); }"
    echo ""
    echo "  /* Заглушки для mpv */"
    echo "  void terminal_in_background(void) {}"
    echo "  void mp_uninit_ipc(void) {}"
    echo "  void mp_init_ipc(void) {}"
    echo "  void terminal_get_size(void) {}"
    echo "  void terminal_init(void) {}"
    echo "  void terminal_uninit(void) {}"
    echo "  void terminal_setup_getch(void) {}"
    echo "  void mp_ipc_start_anon_client(void) {}"
    echo "  void terminal_set_mouse_input(void) {}"
    echo "  void terminal_get_size2(void) {}"
    echo "}"
  } > src/ps4_polyfill.cpp
  sed -i "s/'convert.cc'/'ps4_polyfill.cpp', 'convert.cc'/g" src/meson.build

  meson setup build --cross-file ps4_cross.txt \
    --prefix="/usr" --libdir="lib" --default-library=static \
    -Dopengl=disabled -Dgl-proc-addr=disabled -Dd3d11=disabled \
    -Dglslang=disabled -Dshaderc=disabled \
    -Ddovi=disabled -Dlibdovi=disabled \
    -Dlcms=disabled -Dvulkan=disabled \
    -Ddemos=false -Dtests=false \
    -Dcpp_args="-nostdinc++ -isystem /opt/pacbrew/ps4/openorbis/include/c++/v1 -D__CORRECT_ISO_CPP_MATH_H_PROTO1"

  meson compile -C build
}

package() {
  cd libplacebo-v${pkgver}
  DESTDIR="${pkgdir}/opt/pacbrew/ps4/openorbis" meson install -C build

  local source_dir="${pkgdir}/opt/pacbrew/ps4/openorbis/usr/libdata/pkgconfig"
  local target_dir="${pkgdir}/opt/pacbrew/ps4/openorbis/usr/lib/pkgconfig"

  if [ -d "${source_dir}" ]; then
    mkdir -p "${target_dir}"
    mv -v "${source_dir}"/* "${target_dir}/"
    rm -rf "${pkgdir}/opt/pacbrew/ps4/openorbis/usr/libdata"
  fi
}